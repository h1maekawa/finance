# Supabase（データ用。認証は Firebase のみ）
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Firebase（ログインは Firebase のみ・Google ソーシャルログイン）
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# 株価連携（finnhub）
VITE_FINNHUB_API_KEY=your-finnhub-api-key
# 株価連携（Alpha Vantage, finnhub未設定時に使用）
VITE_ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key

# Optional for legacy fallback only
VITE_DEV_HOUSEHOLD_ID=YOUR_HOUSEHOLD_ID_FOR_LOCAL_ONLY
VITE_INITIAL_ASSETS=0
